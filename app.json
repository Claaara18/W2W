{
  "expo": {
    "name": "w2w2",
    "slug": "w2w2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow W2W to access your photos to upload clothing items.",
          "cameraPermission": "Allow W2W to use the camera to photograph your clothing."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow W2W to access your location for weather information."
        }
      ]
    ]
  }
}
